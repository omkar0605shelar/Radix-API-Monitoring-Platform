# ==============================================================================
# RADIX 2.0 — SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
# Rate limiting: In production, limits requests to 100 per 15 mins per IP.
# Set to 'development' for 10,000 req/15min if testing heavily.

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND DOMAIN ORIGINS
# ------------------------------------------------------------------------------
# In production, set this to your deployed frontend domain (Vercel/Netlify/Custom Domain).
# You can also supply an AWS EC2 Public IP if serving directly.
FRONTEND_URL=https://your-radix-frontend.vercel.app
AWS_EC2_IP=

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL + PRISMA)
# ------------------------------------------------------------------------------
# PostgreSQL connection string. Supports Neon, Supabase, AWS RDS, Railway, Render, or Docker.
# Note: In production cloud databases, append "?schema=public&sslmode=require" if SSL is enforced.
DATABASE_URL="postgresql://postgres:your_password@ep-sample-db.us-east-1.aws.neon.tech/api_insight?schema=public&sslmode=require"

# ------------------------------------------------------------------------------
# 4. REDIS CACHE & ANOMALY ROLLING BASELINES
# ------------------------------------------------------------------------------
# Redis instance used for cache remediation, rate limiters, and telemetry baselines.
# Supports Upstash Redis, Redis Cloud, AWS ElastiCache, or Docker.
REDIS_URL=redis://default:your_redis_password@your-redis-host:6379

# ------------------------------------------------------------------------------
# 5. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Random secure string used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=replace_with_a_cryptographically_secure_random_64_char_string

# ------------------------------------------------------------------------------
# 6. AI ROOT CAUSE ANALYSIS & SRE INTELLIGENCE (NVIDIA NIM)
# ------------------------------------------------------------------------------
# NVIDIA NIM API key (starts with nvapi-...)
# Obtain from: https://build.nvidia.com/
# If left empty or set to 'mock_key', RADIX automatically switches to its built-in
# Deterministic SRE Heuristic Engine (zero crashes, 100% uptime fallback).
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ------------------------------------------------------------------------------
# 7. AUTOMATED REMEDIATION ENGINE
# ------------------------------------------------------------------------------
# REMEDIATION_MODE: 'simulation' or 'production'
# REMEDIATION_SIMULATION_MODE: true / false
# In simulation mode (recommended by default), high-risk actions (pod restarts,
# DB pool resets, rate throttles) run simulated execution logs without touching live infra.
# 'clear_cache' connects to real Redis in production mode.
REMEDIATION_MODE=simulation
REMEDIATION_SIMULATION_MODE=true

# ------------------------------------------------------------------------------
# 8. INCIDENT NOTIFICATIONS & WEBHOOK INTEGRATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
# Slack Incoming Webhook, Discord Webhook, or PagerDuty/Opsgenie endpoint
# When an incident is opened or resolved, automated alerts are POSTed here.
INCIDENT_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXX

# ------------------------------------------------------------------------------
# 9. FIREBASE ADMIN SDK (OPTIONAL - ONLY IF GOOGLE OAUTH / FIREBASE IS USED)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
