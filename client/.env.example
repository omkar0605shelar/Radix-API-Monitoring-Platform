# ==============================================================================
# RADIX 2.0 — CLIENT (FRONTEND) ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: In Vite, all environment variables prefixed with VITE_ are baked into the
# static JavaScript bundle at BUILD TIME (npm run build).
# When deploying to Vercel, Netlify, Render, or Docker, you MUST define these in your
# cloud provider's Environment Variables dashboard BEFORE triggering the build!
# ==============================================================================

# Backend API Base URL
# - Point to your deployed server URL (e.g. Render, Railway, AWS EC2, or custom domain)
# - Socket.io will automatically connect to this URL for live telemetry & incident feeds
# - For local development: http://localhost:5000
VITE_API_URL=https://api.yourdomain.com

# ------------------------------------------------------------------------------
# FIREBASE AUTHENTICATION (OPTIONAL - ONLY IF FIREBASE LOGIN IS ENABLED)
# ------------------------------------------------------------------------------
VITE_FIREBASE_APIKEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
